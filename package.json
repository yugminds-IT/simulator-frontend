{
  "name": "robo-coders-learn-kit",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && mkdir -p dist/models && cp models/*.glb models/manifest.json dist/models/",
    "preview": "vite preview",
    "models": "/Applications/Blender.app/Contents/MacOS/Blender -b --factory-startup -P models/src/build.py --",
    "check": "node models/check.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "gltf-validator": "^2.0.0-dev.3.10",
    "vite": "^8.3.8"
  }
}
